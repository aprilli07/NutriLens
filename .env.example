# MySQL connection used by the API server and scripts
DATABASE_URL=mysql://nutrilens:change-me@127.0.0.1:3306/nutrilens
# Long random string used to sign login tokens (e.g. `openssl rand -hex 32`)
JWT_SECRET=
PORT=5001
# Optional: enables AI explanations and alternatives (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Used by the Expo app. On a physical phone, use your computer's LAN IP, e.g. http://192.168.1.20:5001
EXPO_PUBLIC_API_URL=http://localhost:5001
